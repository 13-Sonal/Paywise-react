# Copy to .env.development.local (or .env.local) and adjust.
# Everything prefixed with VITE_ is bundled into the browser build and is PUBLIC.
# Never put secrets (client secrets, API keys, tokens) in these variables.

# Base URL of the Rails API. Leave empty in development: Vite proxies /api to
# API_PROXY_TARGET (default http://localhost:3000), so no CORS setup is needed.
# For a deployed build, set the full URL, e.g. https://api.paywise.example
VITE_API_BASE_URL=

# Dev-server only (not bundled): where Vite forwards /api requests.
API_PROXY_TARGET=http://localhost:3000
